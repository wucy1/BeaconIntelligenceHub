# --- Local Postgres (docker compose) ---
DATABASE_URL=postgresql+psycopg2://crisis:crisis@127.0.0.1:5432/crisis

# --- Neon (production): use sslmode=require, run PostGIS + schema from backend/db/init.sql ---
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

STORAGE_PATH=./storage
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Comma-separated. Add your Cloudflare Pages URL(s), e.g. https://bih.pages.dev
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Optional Cloudflare R2 (S3-compatible). If all four are set, images go to R2. ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Local dev (PUBLIC_BASE_URL with localhost): browser uploads via API → server PUTs to R2 (no bucket CORS).
# Production direct browser→R2: set PUBLIC_BASE_URL to your API host and UPLOAD_VIA_API=false
# UPLOAD_VIA_API=true

# Admin API (optional): X-Admin-Token header for /v1/admin/*
# ADMIN_TOKEN=change-me-in-production
# REPORTER_SALT=change-me-in-production
# ACTIVE_CRISIS_ID=a0000000-0000-0000-0000-000000000001
